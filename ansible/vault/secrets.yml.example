---
# Example structure — do NOT put real secrets here.
# Create the encrypted file instead:
#
#   ansible-vault create ansible/vault/secrets.yml
#
# Bootstrap (Tailscale):
#   tailscale_authkey: "tskey-auth-xxxxxxxx"
#   Must be reusable/pre-authorized — the bootstrap playbook reruns after every OS reinstall.
#
# Docker stack (required unless noted):
#   samba_password: "your-samba-password"
#
#   GitHub deploy keys — one per private repo (deploy keys are repo-scoped, so the same key
#   cannot be shared between repos). Generate each with, e.g.:
#     ssh-keygen -t ed25519 -f deploy_key_home_server_configuration -N ""
#   then add the *public* half as a read-only deploy key on the corresponding GitHub repo,
#   and the *private* half here:
#   github_clone_ssh_key_home_server_configuration: |
#     -----BEGIN OPENSSH PRIVATE KEY-----
#     ...
#     -----END OPENSSH PRIVATE KEY-----
#   github_clone_ssh_key_private_home_server: |
#     -----BEGIN OPENSSH PRIVATE KEY-----
#     ...
#     -----END OPENSSH PRIVATE KEY-----

tailscale_authkey: "tskey-auth-REPLACE-ME"
samba_password: "REPLACE-ME"
github_clone_ssh_key_home_server_configuration: ""
github_clone_ssh_key_private_home_server: ""
