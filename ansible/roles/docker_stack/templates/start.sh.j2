#!/usr/bin/env bash
# Manual break-glass fallback only — the "Deploy" GitHub Actions workflow now calls
# `ansible-playbook site.yml --tags deploy` directly (same tasks, single source of truth).
# Kept here for cases where you need to redeploy by SSHing in directly, without CI.
set -euo pipefail

BRANCH="${1:-{{ deploy_branch }}}"
BASE="{{ deploy_base_dir }}"
PROFILE_ARGS=({% for profile in docker_compose_profiles %}--profile {{ profile }} {% endfor %})
ALL_PROFILE_ARGS=({% for profile in docker_compose_all_profiles %}--profile {{ profile }} {% endfor %})
VPN_PROFILE_ARGS=(--profile {{ vpn_profile }})
HOME_SERVER_DIR="${BASE}/home-server"
HOME_SERVER_CONFIGURATION_DIR="${BASE}/home-server-configuration"
PRIVATE_HOME_SERVER_DIR="${BASE}/private-home-server"

# Switch a repo to $BRANCH if it exists on origin, otherwise fall back to main.
# Args: $1 = repo path, $2 = required (1 = exit if $BRANCH is missing and not main)
switch_repo() {
    repo_path="$1"
    required="$2"

    cd "${repo_path}"
    git restore .
    git fetch origin

    if git ls-remote --heads origin "${BRANCH}" | grep -q "${BRANCH}"; then
        git checkout -B "${BRANCH}" "origin/${BRANCH}"
        echo "${repo_path}: switched to ${BRANCH}"
    else
        if [ "${required}" = "1" ] && [ "${BRANCH}" != "main" ]; then
            echo "ERROR: branch '${BRANCH}' not found in ${repo_path} (required)"
            exit 1
        fi
        git checkout -B main origin/main
        echo "${repo_path}: using main (branch '${BRANCH}' not found)"
    fi
}

switch_repo "${HOME_SERVER_CONFIGURATION_DIR}" 0
switch_repo "${PRIVATE_HOME_SERVER_DIR}" 0
switch_repo "${HOME_SERVER_DIR}" 1

echo "Starting stack..."
cd "${HOME_SERVER_DIR}"
docker compose \
  -f "${HOME_SERVER_DIR}/docker-compose.yaml" \
  -f "${PRIVATE_HOME_SERVER_DIR}/docker-compose.yaml" \
  --env-file "${HOME_SERVER_DIR}/.env" \
  "${ALL_PROFILE_ARGS[@]}" \
  pull
docker compose \
  -f "${HOME_SERVER_DIR}/docker-compose.yaml" \
  -f "${PRIVATE_HOME_SERVER_DIR}/docker-compose.yaml" \
  --env-file "${HOME_SERVER_DIR}/.env" \
  "${PROFILE_ARGS[@]}" \
  up -d --remove-orphans

# openvpn and the services sharing its network namespace (home-assistant, jellyfin) depend
# on an external VPN provider account. Started separately, best-effort, so a VPN
# outage/credential problem can't abort the rest of the stack (already up above).
if ! docker compose \
  -f "${HOME_SERVER_DIR}/docker-compose.yaml" \
  -f "${PRIVATE_HOME_SERVER_DIR}/docker-compose.yaml" \
  --env-file "${HOME_SERVER_DIR}/.env" \
  "${VPN_PROFILE_ARGS[@]}" \
  up -d --remove-orphans; then
    echo "WARNING: openvpn/home-assistant/jellyfin failed to start. This is usually an" \
         "external VPN provider/account issue, not a stack problem — check your VPN" \
         "account status/credentials, then re-run this script."
fi

docker image prune -a -f
