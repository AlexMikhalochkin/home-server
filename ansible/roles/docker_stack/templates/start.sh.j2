#!/usr/bin/env bash
# Manual break-glass fallback only — the "Deploy" GitHub Actions workflow now calls
# `ansible-playbook site.yml --tags deploy` directly (same tasks, single source of truth).
# Kept here for cases where you need to redeploy by SSHing in directly, without CI.
set -euo pipefail

DEFAULT_BRANCH={{ deploy_branch | quote }}
BRANCH="${1:-$DEFAULT_BRANCH}"
BASE="{{ deploy_base_dir }}"
COMPOSE_FILE_ARGS=({% for compose_file in docker_compose_files %}-f "{{ compose_file }}" {% endfor %})
PROFILE_ARGS=({% for profile in docker_compose_profiles %}--profile {{ profile }} {% endfor %})
HOME_SERVER_DIR="${BASE}/home-server"
HOME_SERVER_CONFIGURATION_DIR="${BASE}/home-server-configuration"
PRIVATE_HOME_SERVER_DIR="${BASE}/private-home-server"

{% if docker_stack_storage_containers | length > 0 %}
if ! mountpoint -q "{{ docker_stack_storage_mount_path }}"; then
    echo "ERROR: {{ docker_stack_storage_mount_path }} is not mounted; refusing to start storage-dependent containers."
    exit 1
fi
{% endif %}

# Switch a repo to $BRANCH if it exists on origin, otherwise fall back to main.
# Args: $1 = repo path, $2 = required (1 = exit if $BRANCH is missing and not main)
switch_repo() {
    repo_path="$1"
    required="$2"

    cd "${repo_path}"
    if [ "${repo_path}" = "${HOME_SERVER_CONFIGURATION_DIR}" ]; then
        if ! git diff --quiet || ! git diff --cached --quiet; then
            echo "ERROR: private configuration has local changes; back up and reconcile settings before deploying." >&2
            exit 1
        fi
    else
        git restore .
    fi
    git fetch origin

    if git ls-remote --exit-code --heads origin "${BRANCH}" > /dev/null; then
        git checkout -B "${BRANCH}" "origin/${BRANCH}"
        echo "${repo_path}: switched to ${BRANCH}"
    else
        lookup_status=$?
        if [ "${lookup_status}" -ne 2 ]; then
            echo "ERROR: branch lookup failed in ${repo_path} (rc=${lookup_status})" >&2
            exit "${lookup_status}"
        fi
        if [ "${required}" = "1" ] && [ "${BRANCH}" != "main" ]; then
            echo "ERROR: branch '${BRANCH}' not found in ${repo_path} (required)"
            exit 1
        fi
        git checkout -B main origin/main
        echo "${repo_path}: using main (branch '${BRANCH}' not found)"
    fi
}

{% if home_server_configuration_enabled | bool %}switch_repo "${HOME_SERVER_CONFIGURATION_DIR}" 0
{% endif %}{% if private_home_server_enabled | bool %}switch_repo "${PRIVATE_HOME_SERVER_DIR}" 0
{% endif %}switch_repo "${HOME_SERVER_DIR}" 1

echo "Starting stack..."
cd "${HOME_SERVER_DIR}"
docker compose \
  "${COMPOSE_FILE_ARGS[@]}" \
  --env-file "${HOME_SERVER_DIR}/.env" \
  "${PROFILE_ARGS[@]}" \
  pull
docker compose \
  "${COMPOSE_FILE_ARGS[@]}" \
  --env-file "${HOME_SERVER_DIR}/.env" \
  "${PROFILE_ARGS[@]}" \
  up -d --wait --wait-timeout 360 --remove-orphans

{% if docker_stack_storage_containers | length > 0 %}
docker update --restart={{ docker_stack_storage_restart_policy }} {{ docker_stack_storage_containers | join(' ') }}
{% endif %}

docker image prune -a -f
