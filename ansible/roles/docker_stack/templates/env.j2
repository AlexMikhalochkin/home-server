# Managed by Ansible — see ansible/roles/docker_stack/templates/env.j2
{% for key, value in stack_env.items() %}
{{ key }}={{ value }}
{% endfor %}
DEPLOY_UID={{ deploy_user_uid }}
DEPLOY_GID={{ deploy_user_gid }}
{% if media_access_enabled | default(false) %}
MEDIA_UID={{ media_user_uid }}
MEDIA_GID={{ media_user_gid }}
MEDIA_VIDEO_GID={{ media_video_gid }}
MEDIA_RENDER_GID={{ media_render_gid }}
{% endif %}
