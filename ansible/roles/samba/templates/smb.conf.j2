[global]
   workgroup = {{ samba_workgroup }}
   server string = Home server Samba
   security = user
   map to guest = Bad User
   dns proxy = no

{% for share in samba_shares %}
[{{ share.name }}]
   comment = {{ share.comment }}
   path = {{ share.path }}
   browseable = yes
   read only = no
   guest ok = no
   valid users = {{ samba_user }}
   force user = {{ samba_user }}
   create mask = 0664
   directory mask = 0775
{% endfor %}
