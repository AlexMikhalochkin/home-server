# This is an example configuration for demonstration purposes only
# Copy this file to .env and adjust the values according to your setup

HOME_ASSISTANT_CONFIGURATION_DIRECTORY=./homeassistant/config
PLEX_CONFIG_DIRECTORY=./plex
PLEX_CONTENT_DIRECTORY=/media/disk/sambashare
TIMEZONE=Europe/Berlin
HOST_IP=192.168.1.1

# Owner of the mosquitto/zigbee2mqtt bind-mounted data. Must match the uid:gid that actually
# owns those files on the host (e.g. the deploy user's real uid/gid — see
# ansible/roles/deploy_user). Defaults to 999:989 for local/manual runs if unset.
# DEPLOY_UID=999
# DEPLOY_GID=989

